# ============================================================================
# FixFlow Backend Configuration (Node.js + Express.js + WampServer MySQL)
# ============================================================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173

# WampServer MySQL Database Settings (Default WampServer: root with empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fixflow_db
DB_USERNAME=root
DB_PASSWORD=

# JWT Secret
JWT_SECRET=fixflow_super_secret_jwt_key_2026_wampserver
JWT_EXPIRES_IN=7d

# Default Demo Account Password (works immediately on seed.sql accounts)
DEMO_DEFAULT_PASSWORD=Demo1234!
ADMIN_DEFAULT_PASSWORD=Admin123!

# SMS OTP Configuration (simulated | notifylk | textlk | webhook)
SMS_DRIVER=simulated
SMS_API_URL=https://app.notify.lk/api/v1/send
SMS_USER_ID=
SMS_API_KEY=
SMS_SENDER_ID=FixFlow
SMS_OTP_EXPIRY_MINUTES=5
SMS_OTP_RESEND_COOLDOWN_SECONDS=60
SMS_OTP_MAX_ATTEMPTS=5

# Payment Gateway Configuration (demo | sandbox | live)
PAYMENT_MODE=demo
CURRENCY_CODE=LKR
CURRENCY_SYMBOL=Rs.
PAYHERE_MERCHANT_ID=1210000
PAYHERE_MERCHANT_SECRET=SANDBOX_SECRET
PAYHERE_CHECKOUT_URL=https://sandbox.payhere.lk/pay/checkout

# Security Rate Limits
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15